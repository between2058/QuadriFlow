# =============================================================================
# QuadriFlow API — Machine-specific configuration
#
# Usage:
#   cp .env.example .env
#   vim .env              # fill in paths for THIS machine
#   docker compose up -d
#
# .env is gitignored — never commit it.
# =============================================================================

# ── Output directory (persistent storage for API-generated files) ────────────
# The service writes outputs to /app/outputs inside the container.
# This host path is mounted so files survive container restarts.
#
# Examples:
#   /data/quadriflow_outputs               (prod server)
#   ./outputs                              (dev — relative to compose file)
QUADRIFLOW_OUTPUT_PATH=./outputs

# ── Auto-cleanup ─────────────────────────────────────────────────────────────
# Output directories older than this (seconds) are automatically deleted.
# Default: 86400 (24 hours). Set to 0 to disable.
OUTPUT_TTL_SECONDS=86400

# ── Port mapping (change if default conflicts) ──────────────────────────────
QUADRIFLOW_PORT=8200

# ── Corporate proxy (set to empty string if not needed) ─────────────────────
HTTP_PROXY=
HTTPS_PROXY=
